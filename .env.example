# Campus Deadline Radar + Campus Assessment Hub
# Environment Configuration

# Next.js Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Authentication & PostgreSQL Database
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Payment Gateway (Razorpay)
# When keys are omitted, the application operates in safe, verified Test Mode
RAZORPAY_KEY_ID="rzp_test_exampleKey123"
RAZORPAY_KEY_SECRET="your-razorpay-secret-key"
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"
NEXT_PUBLIC_RAZORPAY_PAYMENT_URL="https://rzp.io/rzp/CkGK3Dv"

# Isolated Code Execution Service (Judge0 or equivalent secure runner)
# When omitted, built-in deterministic sandbox mock runner handles test cases
JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"
JUDGE0_API_KEY=""

# Optional AI Content Generation (OpenAI / Claude / Gemini)
# When omitted, manual CSV import and curated templates are available
AI_MODEL_API_KEY=""
