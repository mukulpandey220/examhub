# Campus Deadline Radar + Campus Assessment Hub
# Environment Configuration

# Next.js Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Authentication & PostgreSQL Database
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Payment Gateway (Razorpay)
# The site always opens this existing payment page. Do not replace it.
# Access is granted only after server-side verification. Placeholder values below do not verify payments.
#
# Dashboard settings you must set yourself:
# 1. Razorpay payment page https://rzp.io/rzp/CkGK3Dv
#    Callback URL: http://localhost:3000/payment/callback
#    Callback method: GET
# 2. Razorpay Webhooks
#    URL: http://localhost:3000/api/checkout/webhook
#    Event: payment_link.paid
#    Secret: the same value as RAZORPAY_WEBHOOK_SECRET
# 3. Payment page id behind that short link. Leave blank to resolve it from the page,
#    or set the id shown in the Razorpay dashboard. As of 2026-10-29 the public page is pl_TsvSvawxzAhYvE.
RAZORPAY_KEY_ID="rzp_test_exampleKey123"
RAZORPAY_KEY_SECRET="your-razorpay-secret-key"
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"
RAZORPAY_PAYMENT_LINK_ID=""
NEXT_PUBLIC_RAZORPAY_PAYMENT_URL="https://rzp.io/rzp/CkGK3Dv"

# Isolated Code Execution Service (Judge0 or equivalent secure runner)
# When omitted, built-in deterministic sandbox mock runner handles test cases
JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"
JUDGE0_API_KEY=""

# Optional AI Content Generation (OpenAI / Claude / Gemini)
# When omitted, manual CSV import and curated templates are available
AI_MODEL_API_KEY=""
